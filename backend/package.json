{
  "name": "avellaneda-fc-backend",
  "version": "1.0.0",
  "description": "API REST para Avellaneda FC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrate.js",
    "migrate:resources": "node migrate-recursos.js",
    "migrate:administradores": "node migrate-administradores.js",
    "migrate:reportes": "node migrate-reportes-db.js",
